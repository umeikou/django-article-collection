# Django配置
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库配置
DATABASE_URL=sqlite:///articles.db

# DeepSeek API 配置
# 获取 API Key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# AI功能开关
ENABLE_AI_ANALYSIS=True

# 邮件发送通道：aliyun_dm（默认）/ qq_smtp
EMAIL_BACKEND=aliyun_dm

# QQ 邮箱 SMTP 配置（仅 EMAIL_BACKEND=qq_smtp 时需要）
# 1) 登录 https://mail.qq.com 设置 → 账户 → 开启 IMAP/SMTP
# 2) 生成 16 位授权码（不是 QQ 登录密码），填到 QQ_EMAIL_AUTH_CODE
QQ_EMAIL_USER=
QQ_EMAIL_AUTH_CODE=
QQ_EMAIL_FROM_NAME=阅读分享周刊
